# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
# Public base URL of this server (used in file and avatar links the app opens).
PUBLIC_URL=http://localhost:3000

# MariaDB (docker compose up -d db uses the DB_* values)
DB_NAME=cure
DB_USER=cure
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_too
DB_PORT=3306
DATABASE_URL="mysql://cure:change_me@127.0.0.1:3306/cure"

# Where ID scans and result PDFs are stored (not publicly served).
STORAGE_DIR=storage

# AI provider. Swap provider/model here; the app never sees the key.
# The free Gemini tier is for demo/testing with FAKE data only: Google may use
# unpaid-tier inputs to improve its products and human reviewers may read them.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

# WhatsApp codes (UltraMSG). Empty in development = codes are printed to the server log.
ULTRAMSG_API_URL=
ULTRAMSG_TOKEN=

# Seed: the demo lab user created by `bun run db:seed`.
SEED_LAB_USERNAME=lab1
SEED_LAB_PASSWORD=change_me_lab
